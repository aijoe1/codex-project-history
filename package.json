{
  "name": "codex-project-history",
  "displayName": "Codex Project History",
  "description": "Search active and archived local Codex chats with repository, branch, and working-directory context.",
  "version": "0.2.0",
  "private": true,
  "publisher": "aijoe1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aijoe1/codex-project-history.git"
  },
  "homepage": "https://github.com/aijoe1/codex-project-history#readme",
  "bugs": {
    "url": "https://github.com/aijoe1/codex-project-history/issues"
  },
  "keywords": [
    "codex",
    "chat history",
    "project",
    "workspace"
  ],
  "scripts": {
    "test": "node --test test/history.test.js",
    "check": "node --check extension.js && node --check src/history.js && node --check src/transcript.js && node --check src/restore.js && node --check scripts/smoke.js",
    "package:vsix": "mkdir -p dist && vsce package --out dist/codex-project-history-${npm_package_version}.vsix"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexProjectHistory.open",
    "onCommand:codexProjectHistory.openArchived",
    "onCommand:codexProjectHistory.restoreArchived"
  ],
  "main": "./extension.js",
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexProjectHistory.open",
        "title": "Search Chats by Project",
        "category": "Codex"
      },
      {
        "command": "codexProjectHistory.openArchived",
        "title": "Search Archived Chats by Project",
        "category": "Codex"
      },
      {
        "command": "codexProjectHistory.restoreArchived",
        "title": "Restore Archived Chat",
        "category": "Codex"
      }
    ],
    "keybindings": [
      {
        "command": "codexProjectHistory.open",
        "key": "ctrl+alt+h",
        "mac": "ctrl+cmd+h"
      }
    ],
    "configuration": {
      "title": "Codex Project History",
      "properties": {
        "codexProjectHistory.maxChats": {
          "type": "number",
          "default": 300,
          "minimum": 25,
          "maximum": 1000,
          "description": "Maximum number of active or archived local VS Code Codex chats to show in each picker."
        },
        "codexProjectHistory.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a distinct Project Chats shortcut in the VS Code status bar."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
